# ── Основное ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Внешний адрес API (для ссылок на локально сохранённые картинки)
PUBLIC_URL=http://localhost:3000
# Адрес веб-админки (CORS и ссылки в уведомлениях)
ADMIN_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://history:history@localhost:5432/history
VENUE_TIMEZONE=Europe/Moscow

# ── Безопасность (в production обязательно, длинные случайные строки) ──
JWT_SECRET=
OTP_SECRET=
JWT_ACCESS_TTL_SEC=900
JWT_GUEST_REFRESH_TTL_DAYS=90
JWT_STAFF_REFRESH_TTL_DAYS=7

# Первый администратор админки (создаётся, если сотрудников ещё нет)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ── Вход по SMS ───────────────────────────────────────────
# console — код пишется в лог (разработка); smsru — SMS.ru
SMS_PROVIDER=console
SMSRU_API_ID=
SMS_SENDER=
OTP_TTL_SEC=300
OTP_RESEND_COOLDOWN_SEC=60
OTP_MAX_PER_HOUR=5
OTP_MAX_ATTEMPTS=5
# Демо-номер для ревью App Store / Google Play (фиксированный код, без SMS)
OTP_REVIEW_PHONE=
OTP_REVIEW_CODE=

# Версия политики ПДн. Повышение — приложение попросит согласие заново.
PRIVACY_POLICY_VERSION=2026-09-28

# ── iiko (бонусная программа) ─────────────────────────────
# mock — имитация для разработки; cloud — реальный iikoCloud API
IIKO_MODE=mock
IIKO_BASE_URL=https://api-ru.iiko.services
IIKO_API_LOGIN=
IIKO_ORGANIZATION_ID=
# Префикс номеров виртуальных карт, выпускаемых приложением
IIKO_VIRTUAL_CARD_PREFIX=7707

# ── Push (Firebase Cloud Messaging) ───────────────────────
# JSON сервисного аккаунта одной строкой. Пусто — пуши только логируются.
FIREBASE_SERVICE_ACCOUNT_JSON=
FCM_NEWS_TOPIC=news

# ── Хранилище картинок ────────────────────────────────────
# local — папка ./uploads; s3 — S3-совместимое (Yandex Object Storage, Selectel, MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# ── Уведомления об обращениях ("Жалоба") ──────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# smtps://user:pass@smtp.yandex.ru:465
SMTP_URL=
FEEDBACK_EMAIL_FROM=
FEEDBACK_EMAIL_TO=
